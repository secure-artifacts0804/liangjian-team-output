# Google Apps Script Web App URL. Keep the real value in the deployment environment.
DRIVE_SCANNER_URL=https://script.google.com/macros/s/REPLACE_ME/exec
# Long random value shared only by the app server and Apps Script properties.
DRIVE_SCANNER_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# At least 32 random characters. Used only to sign HttpOnly login sessions.
APP_SESSION_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
